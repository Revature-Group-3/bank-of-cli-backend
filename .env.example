#use this as a template for your local .env file

#generate your own 32-byte base64 secret key.
JWT_SECRET=secret_key_go_here

#this is the URL used for my docker container, I just use the chinook with a new database, change as needed
DB_URL=jdbc:postgresql://localhost:5432/bank_of_cli

#change the username and password to your credentials for the database you're using to test with.
DB_USERNAME=db_name_go_here
DB_PASSWORD=db_password_go_here